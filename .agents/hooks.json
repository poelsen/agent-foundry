{
  "agent-foundry": {
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "bash agent-foundry/hooks/ruff-format.sh",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "bash agent-foundry/hooks/mypy-check.sh",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
